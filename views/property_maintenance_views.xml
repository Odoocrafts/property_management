<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property Maintenance Form View -->
    <record id="property_maintenance_view_form" model="ir.ui.view">
        <field name="name">property.maintenance.form</field>
        <field name="model">property.maintenance</field>
        <field name="arch" type="xml">
            <form string="Maintenance Request">
                <header>
                    <button name="action_assign" string="Assign" type="object"
                            class="oe_highlight" invisible="state != 'new'"/>
                    <button name="action_start" string="Start Work" type="object"
                            class="oe_highlight" invisible="state != 'assigned'"/>
                    <button name="action_complete" string="Mark as Done" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('done', 'cancelled')"/>
                    <button name="action_reopen" string="Reopen" type="object" 
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,assigned,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="property_id" options="{'no_create': True}"/>
                            <field name="unit_id" options="{'no_create': True}" context="{'default_property_id': property_id}"/>
                            <field name="request_by" options="{'no_create': True}"/>
                            <field name="priority" widget="priority"/>
                            <field name="maintenance_type"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="request_date"/>
                            <field name="schedule_date"/>
                            <field name="assign_to" options="{'no_create': True}"/>
                            <field name="start_date" readonly="1" invisible="start_date == False"/>
                            <field name="end_date" readonly="1" invisible="end_date == False"/>
                            <field name="cost" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Description">
                            <field name="description" placeholder="Describe the maintenance issue..."/>
                        </page>
                        <page string="Solution">
                            <field name="solution" placeholder="Describe how the issue was resolved..."/>
                        </page>
                        <page string="Photos/Attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                        <page string="Checklist" invisible="state not in ('assigned', 'in_progress', 'done')">
                            <field name="checklist_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="is_done"/>
                                    <field name="done_date" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Materials" invisible="state not in ('assigned', 'in_progress', 'done')">
                            <field name="material_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="product_uom" groups="uom.group_uom"/>
                                    <field name="price_unit"/>
                                    <field name="currency_id" invisible="1"/>
                                    <field name="subtotal" sum="Total" widget="monetary"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="materials_cost" widget="monetary"/>
                                <field name="labor_cost" widget="monetary"/>
                                <div class="oe_subtotal_footer_separator oe_inline">
                                    <label for="total_cost"/>
                                </div>
                                <field name="total_cost" class="oe_subtotal_footer_separator" widget="monetary"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Property Maintenance List View -->
    <record id="property_maintenance_view_tree" model="ir.ui.view">
        <field name="name">property.maintenance.list</field>
        <field name="model">property.maintenance</field>
        <field name="arch" type="xml">
            <list string="Maintenance Requests" decoration-danger="state == 'new'" 
                  decoration-primary="state == 'in_progress'" decoration-success="state == 'done'"
                  decoration-muted="state == 'cancelled'" decoration-info="state == 'assigned'">
                <field name="name"/>
                <field name="property_id"/>
                <field name="unit_id"/>
                <field name="request_by"/>
                <field name="request_date"/>
                <field name="schedule_date"/>
                <field name="assign_to"/>
                <field name="maintenance_type"/>
                <field name="priority" widget="priority"/>
                <field name="currency_id" invisible="1"/>
                <field name="total_cost" sum="Total Cost" widget="monetary"/>
                <field name="state"/>
            </list>
        </field>
    </record>
    
    <!-- Property Maintenance Kanban View -->
    <record id="property_maintenance_view_kanban" model="ir.ui.view">
        <field name="name">property.maintenance.kanban</field>
        <field name="model">property.maintenance</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column" records_draggable="0">
                <field name="name"/>
                <field name="property_id"/>
                <field name="unit_id"/>
                <field name="request_by"/>
                <field name="assign_to"/>
                <field name="priority"/>
                <field name="maintenance_type"/>
                <field name="schedule_date"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_card">
                                <div class="oe_kanban_content">
                                    <div>
                                        <strong class="o_kanban_record_title"><t t-esc="record.name.value"/></strong>
                                    </div>
                                    <div class="text-muted">
                                        <t t-esc="record.property_id.value"/> - <t t-esc="record.unit_id.value"/>
                                    </div>
                                    <div>
                                        <span t-attf-class="o_priority_star fa fa-star#{record.priority.raw_value > '1' ? '' : '-o'}" 
                                              t-att-title="record.priority.value"/>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <span class="badge" t-attf-class="badge-#{record.maintenance_type.raw_value == 'corrective' ? 'danger' : record.maintenance_type.raw_value == 'preventive' ? 'success' : record.maintenance_type.raw_value == 'emergency' ? 'warning' : 'info'}">
                                                <t t-esc="record.maintenance_type.value"/>
                                            </span>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <img t-att-src="kanban_image('res.users', 'avatar_128', record.assign_to.raw_value)" 
                                                 t-att-title="record.assign_to.value" width="32" height="32" 
                                                 class="oe_kanban_avatar" t-att-style="!record.assign_to.raw_value ? 'display:none' : ''"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Property Maintenance Calendar View -->
    <record id="property_maintenance_view_calendar" model="ir.ui.view">
        <field name="name">property.maintenance.calendar</field>
        <field name="model">property.maintenance</field>
        <field name="arch" type="xml">
            <calendar string="Maintenance Schedule" date_start="schedule_date" color="assign_to" mode="month">
                <field name="name"/>
                <field name="property_id"/>
                <field name="unit_id"/>
                <field name="maintenance_type"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <!-- Property Maintenance Search View -->
    <record id="property_maintenance_view_search" model="ir.ui.view">
        <field name="name">property.maintenance.search</field>
        <field name="model">property.maintenance</field>
        <field name="arch" type="xml">
            <search string="Search Maintenance Requests">
                <field name="name"/>
                <field name="property_id"/>
                <field name="unit_id"/>
                <field name="request_by"/>
                <field name="assign_to"/>
                <filter string="New" name="new" domain="[('state', '=', 'new')]"/>
                <filter string="Assigned" name="assigned" domain="[('state', '=', 'assigned')]"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <filter string="High Priority" name="high_priority" domain="[('priority', '=', '3')]"/>
                <filter string="Emergency" name="emergency" domain="[('maintenance_type', '=', 'emergency')]"/>
                <filter string="My Tasks" name="my_tasks" domain="[('assign_to', '=', uid)]"/>
                <filter string="Scheduled Today" name="today" 
                        domain="[('schedule_date', '=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="Overdue" name="overdue" 
                        domain="[('schedule_date', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ['done', 'cancelled'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Property" name="group_by_property" context="{'group_by': 'property_id'}"/>
                    <filter string="Unit" name="group_by_unit" context="{'group_by': 'unit_id'}"/>
                    <filter string="Assigned To" name="group_by_assign" context="{'group_by': 'assign_to'}"/>
                    <filter string="Type" name="group_by_type" context="{'group_by': 'maintenance_type'}"/>
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Priority" name="group_by_priority" context="{'group_by': 'priority'}"/>
                    <filter string="Schedule Month" name="group_by_schedule_date" context="{'group_by': 'schedule_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Property Maintenance Action -->
    <record id="action_property_maintenance" model="ir.actions.act_window">
        <field name="name">Maintenance Requests</field>
        <field name="res_model">property.maintenance</field>
        <field name="view_mode">kanban,list,form,calendar</field>
        <field name="search_view_id" ref="property_maintenance_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first maintenance request
            </p>
            <p>
                Track and manage all property maintenance tasks.
            </p>
        </field>
    </record>
    
    <!-- Maintenance Checklist Item Form View -->
    <record id="maintenance_checklist_item_view_form" model="ir.ui.view">
        <field name="name">maintenance.checklist.item.form</field>
        <field name="model">maintenance.checklist.item</field>
        <field name="arch" type="xml">
            <form string="Checklist Item">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_done"/>
                        <field name="done_date" readonly="1"/>
                        <field name="maintenance_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Maintenance Material Form View -->
    <record id="maintenance_material_view_form" model="ir.ui.view">
        <field name="name">maintenance.material.form</field>
        <field name="model">maintenance.material</field>
        <field name="arch" type="xml">
            <form string="Material">
                <sheet>
                    <group>
                        <field name="product_id"/>
                        <field name="quantity"/>
                        <field name="product_uom" groups="uom.group_uom"/>
                        <field name="price_unit"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="subtotal" readonly="1" widget="monetary"/>
                        <field name="maintenance_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
