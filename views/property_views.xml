<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property Form View -->
    <record id="property_view_form" model="ir.ui.view">
        <field name="name">property.property.form</field>
        <field name="model">property.property</field>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <button name="action_set_under_maintenance" string="Set Under Maintenance" type="object" 
                            class="oe_highlight" invisible="state == 'under_maintenance'"/>
                    <button name="action_set_available" string="Set Available" type="object" 
                            class="oe_highlight" invisible="state == 'available'"/>
                    <button name="action_set_inactive" string="Set Inactive" type="object" 
                            invisible="state == 'inactive'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,available,occupied,partially_occupied,under_maintenance"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_units" type="object" class="oe_stat_button" icon="fa-building-o">
                            <field name="unit_count" widget="statinfo" string="Units"/>
                        </button>
                        <button name="action_view_maintenance" type="object" class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Property Name"/>
                        </h1>
                        <h3>
                            <field name="code" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="type"/>
                            <field name="building_name"/>
                            <field name="acquisition_date"/>
                            <field name="ownership_type"/>
                            <field name="total_area" widget="float"/>
                        </group>
                        <group>
                            <field name="partner_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="purchase_price" widget="monetary"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Address">
                            <group>
                                <group>
                                    <field name="street" placeholder="Street..."/>
                                    <field name="street2" placeholder="Street 2..."/>
                                    <field name="city" placeholder="City"/>
                                </group>
                                <group>
                                    <field name="state_id" placeholder="State" options="{'no_open': True, 'no_create': True}" class="o_address_state" context="{'country_id': country_id}"/>
                                    <field name="zip" placeholder="ZIP"/>
                                    <field name="country_id" placeholder="Country" options="{'no_open': True, 'no_create': True}" class="o_address_country"/>
                                </group>
                            </group>
                        </page>
                        <page string="Units">
                            <field name="unit_ids" context="{'default_property_id': id}" views="property_unit_embedded_view_tree,form"/>
                        </page>
                        <page string="Financial Overview">
                            <group>
                                <group string="Revenue">
                                    <field name="total_expected_revenue" widget="monetary"/>
                                </group>
                                <group string="Expenses">
                                    <field name="total_expenses" widget="monetary"/>
                                </group>
                            </group>
                            <group string="Profitability">
                                <field name="currency_id" invisible="1"/>
                                <field name="monthly_cash_flow" widget="monetary"/>
                            </group>
                        </page>
                        <page string="Description">
                            <field name="description"/>
                        </page>
                        <page string="Documents">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    
    <!-- Property List View -->
    <record id="property_view_tree" model="ir.ui.view">
        <field name="name">property.property.list</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <list string="Properties" decoration-success="state == 'available'" 
                  decoration-danger="state == 'under_maintenance'" decoration-primary="state == 'occupied'"
                  decoration-info="state == 'partially_occupied'">
                <field name="code"/>
                <field name="name"/>
                <field name="building_name"/>
                <field name="city"/>
                <field name="type"/>
                <field name="unit_count"/>
                <field name="total_expected_revenue" widget="monetary" sum="Total Expected Revenue"/>
                <field name="total_expenses" widget="monetary" sum="Total Expenses"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Property Search View -->
    <record id="property_view_search" model="ir.ui.view">
        <field name="name">property.property.search</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <search string="Search Properties">
                <field name="name" string="Property"/>
                <field name="code"/>
                <field name="building_name"/>
                <field name="city"/>
                <field name="partner_id"/>
                <filter string="Available" name="available" domain="[('state', '=', 'available')]"/>
                <filter string="Fully Occupied" name="occupied" domain="[('state', '=', 'occupied')]"/>
                <filter string="Partially Occupied" name="partially_occupied" domain="[('state', '=', 'partially_occupied')]"/>
                <filter string="Under Maintenance" name="under_maintenance" domain="[('state', '=', 'under_maintenance')]"/>
                <filter string="Inactive" name="inactive" domain="[('state', '=', 'inactive')]"/>
                <filter string="Owned Properties" name="owned" domain="[('ownership_type', '=', 'owned')]"/>
                <filter string="Leased Properties" name="leased" domain="[('ownership_type', '=', 'leased')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_by_state" context="{'group_by': 'state'}"/>
                    <filter string="Property Type" name="group_by_type" context="{'group_by': 'type'}"/>
                    <filter string="City" name="group_by_city" context="{'group_by': 'city'}"/>
                    <filter string="Ownership Type" name="group_by_ownership" context="{'group_by': 'ownership_type'}"/>
                    <filter string="Landlord/Owner" name="group_by_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Property Kanban View -->
    <record id="property_view_kanban" model="ir.ui.view">
        <field name="name">property.property.kanban</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <kanban class="o_property_kanban" default_group_by="state">
                <field name="id"/>
                <field name="name"/>
                <field name="code"/>
                <field name="city"/>
                <field name="state"/>
                <field name="unit_count"/>
                <field name="total_expected_revenue"/>
                <field name="currency_id"/>
                <field name="image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click o_kanban_record_has_image_fill o_property_kanban">
                            <div class="o_kanban_image_fill_left d-none d-md-block" t-attf-style="background-image: url(#{kanban_image('property.property', 'image', record.id.raw_value)})" role="img"/>
                            <div class="oe_kanban_details">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <t t-esc="record.name.value"/>
                                            <small class="text-muted"> (<t t-esc="record.code.value"/>)</small>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <t t-if="record.city.value">
                                        <div><i class="fa fa-map-marker"/> <t t-esc="record.city.value"/></div>
                                    </t>
                                    <div class="mt-2">
                                        <span class="badge" t-attf-class="badge-#{record.state.raw_value == 'available' ? 'success' : record.state.raw_value == 'under_maintenance' ? 'danger' : record.state.raw_value == 'occupied' ? 'primary' : 'info'}">
                                            <t t-esc="record.state.value"/>
                                        </span>
                                    </div>
                                    <div class="mt-2">
                                        <strong>Units:</strong> <t t-esc="record.unit_count.value"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_right">
                                        <span class="oe_kanban_amount">
                                            <t t-esc="record.total_expected_revenue.value"/> <t t-esc="record.currency_id.value"/>
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Property Dashboard Graph View -->
    <record id="property_view_graph" model="ir.ui.view">
        <field name="name">property.property.graph</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <graph string="Properties Analysis" sample="1">
                <field name="state"/>
                <field name="total_expected_revenue" type="measure"/>
                <field name="total_expenses" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Property Dashboard Pivot View -->
    <record id="property_view_pivot" model="ir.ui.view">
        <field name="name">property.property.pivot</field>
        <field name="model">property.property</field>
        <field name="arch" type="xml">
            <pivot string="Properties Analysis" sample="1">
                <field name="state" type="row"/>
                <field name="total_expected_revenue" type="measure"/>
                <field name="total_expenses" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Property Action -->
    <record id="action_properties" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">property.property</field>
        <field name="view_mode">kanban,list,form,pivot,graph</field>
        <field name="search_view_id" ref="property_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property
            </p>
            <p>
                Create properties to manage your real estate portfolio.
            </p>
        </field>
    </record>
</odoo>
