<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Lead Form View -->
    <record id="property_lead_view_form" model="ir.ui.view">
        <field name="name">property.lead.form</field>
        <field name="model">property.lead</field>
        <field name="arch" type="xml">
            <form string="Property Lead">
                <header>
                    <button name="action_qualify" string="Qualify" type="object" 
                            class="btn-primary" invisible="state != 'new'"/>
                    <button name="action_create_proposal" string="Create Proposal" type="object" 
                            class="btn-primary" invisible="state not in ['qualified']"/>
                    <button name="action_mark_won" string="Mark Won" type="object" 
                            class="btn-success" invisible="state in ['won', 'lost', 'cancelled']"/>
                    <button name="action_mark_lost" string="Mark Lost" type="object" 
                            class="btn-secondary" invisible="state in ['won', 'lost', 'cancelled']"/>
                    <button name="action_convert_to_booking" string="Convert to Booking" type="object" 
                            class="btn-primary" invisible="state != 'won'"/>
                    <button name="action_convert_to_customer" string="Convert to Customer" type="object" 
                            class="btn-primary" invisible="state != 'won'"/>
                    <field name="state" widget="statusbar" statusbar_visible="new,qualified,proposal,negotiation,won"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_schedule_activity" icon="fa-calendar">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Schedule</span>
                                <span class="o_stat_text">Activity</span>
                            </div>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="Converted" bg_color="bg-success" 
                            invisible="not is_converted"/>
                    
                    <div class="oe_title">
                        <h1>
                            <field name="lead_name" placeholder="Lead Name"/>
                        </h1>
                        <h3>
                            <field name="code" readonly="1"/>
                        </h3>
                    </div>
                    
                    <group>
                        <group name="lead_info" string="Lead Information">
                            <field name="contact_name"/>
                            <field name="email" widget="email"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="source"/>
                            <field name="campaign_id" invisible="source != 'digital_marketing'"/>
                            <field name="lead_type"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group name="assignment" string="Assignment">
                            <field name="assigned_to"/>
                            <!-- <field name="team_id"/> Commented out - CRM dependency -->
                            <field name="stage_id"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    
                    <group>
                        <group name="requirements" string="Requirements">
                            <field name="budget_min" widget="monetary"/>
                            <field name="budget_max" widget="monetary"/>
                            <field name="budget_range" readonly="1"/>
                            <field name="unit_type_preference"/>
                            <field name="location_preference"/>
                            <field name="timeline"/>
                            <field name="investment_purpose"/>
                            <field name="family_size"/>
                        </group>
                        <group name="scoring" string="Lead Scoring">
                            <field name="score" widget="progressbar"/>
                            <field name="probability" widget="percentage"/>
                            <field name="days_since_creation" readonly="1"/>
                            <field name="follow_up_count" readonly="1"/>
                            <field name="last_activity_date" readonly="1"/>
                            <field name="next_activity_date"/>
                        </group>
                    </group>
                    
                    <group name="address" string="Address">
                        <group>
                            <field name="street" placeholder="Street..."/>
                            <field name="street2" placeholder="Street 2..."/>
                            <field name="city" placeholder="City"/>
                        </group>
                        <group>
                            <field name="state_id" placeholder="State"/>
                            <field name="zip" placeholder="ZIP"/>
                            <field name="country_id" placeholder="Country"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Properties of Interest" name="properties">
                            <group>
                                <field name="interested_properties" widget="many2many_tags"/>
                                <field name="interested_units" widget="many2many_tags"/>
                            </group>
                        </page>
                        <page string="Lead Details" name="details">
                            <group>
                                <field name="source_details" placeholder="Additional source information..."/>
                                <field name="description" placeholder="Lead description..."/>
                                <field name="notes" placeholder="Internal notes..."/>
                            </group>
                        </page>
                        <page string="Scoring Details" name="scoring_details">
                            <field name="score_details" readonly="1" nolabel="1"/>
                        </page>
                        <page string="Referral" name="referral" invisible="source != 'referral'">
                            <group>
                                <field name="referral_partner_id"/>
                                <field name="referral_commission_applicable"/>
                            </group>
                        </page>
                        <page string="Conversion" name="conversion" invisible="not is_converted">
                            <group>
                                <field name="is_converted" readonly="1"/>
                                <field name="converted_date" readonly="1"/>
                                <field name="converted_to" readonly="1"/>
                                <field name="booking_id" readonly="1"/>
                                <field name="partner_id" readonly="1"/>
                            </group>
                        </page>
                        <page string="Attachments" name="attachments">
                            <field name="attachment_ids" widget="many2many_binary"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Lead List View -->
    <record id="property_lead_view_tree" model="ir.ui.view">
        <field name="name">property.lead.list</field>
        <field name="model">property.lead</field>
        <field name="arch" type="xml">
            <list string="Property Leads" decoration-info="state == 'new'" 
                  decoration-warning="state == 'qualified'" decoration-success="state == 'won'" 
                  decoration-danger="state == 'lost'">
                <field name="code"/>
                <field name="lead_name"/>
                <field name="contact_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="source"/>
                <field name="budget_range"/>
                <field name="unit_type_preference"/>
                <field name="assigned_to"/>
                <field name="stage_id"/>
                <field name="score" widget="progressbar"/>
                <field name="probability" widget="percentage"/>
                <field name="priority" widget="priority"/>
                <field name="state" widget="badge" decoration-info="state == 'new'" 
                       decoration-warning="state == 'qualified'" decoration-success="state == 'won'" 
                       decoration-danger="state == 'lost'"/>
                <field name="create_date"/>
                <field name="days_since_creation"/>
            </list>
        </field>
    </record>

    <!-- Lead Kanban View -->
    <record id="property_lead_view_kanban" model="ir.ui.view">
        <field name="name">property.lead.kanban</field>
        <field name="model">property.lead</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" class="o_kanban_small_column" quick_create="false">
                <field name="id"/>
                <field name="lead_name"/>
                <field name="contact_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="source"/>
                <field name="budget_range"/>
                <field name="unit_type_preference"/>
                <field name="assigned_to"/>
                <field name="stage_id"/>
                <field name="score"/>
                <field name="probability"/>
                <field name="priority"/>
                <field name="state"/>
                <field name="color"/>
                <field name="create_date"/>
                <field name="activity_ids"/>
                <progressbar field="state" colors='{"won": "success", "lost": "danger", "new": "info", "qualified": "warning"}'/>/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_dropdown_kanban dropdown">
                                <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                    <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                    <a role="menuitem" name="action_schedule_activity" type="object" class="dropdown-item">Schedule Activity</a>
                                </div>
                            </div>
                            <div class="oe_kanban_content">
                                <div class="oe_kanban_details">
                                    <div class="o_kanban_record_top">
                                        <div class="o_kanban_record_headings">
                                            <strong class="o_kanban_record_title">
                                                <t t-esc="record.lead_name.value"/>
                                            </strong>
                                        </div>
                                        <div class="o_kanban_record_subtitle text-muted">
                                            <t t-esc="record.contact_name.value"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_body">
                                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                                        <div t-if="record.email.value">
                                            <i class="fa fa-envelope"/> <t t-esc="record.email.value"/>
                                        </div>
                                        <div t-if="record.phone.value">
                                            <i class="fa fa-phone"/> <t t-esc="record.phone.value"/>
                                        </div>
                                        <div t-if="record.budget_range.value">
                                            <i class="fa fa-money"/> <t t-esc="record.budget_range.value"/>
                                        </div>
                                        <div t-if="record.unit_type_preference.value">
                                            <i class="fa fa-home"/> <t t-esc="record.unit_type_preference.value"/>
                                        </div>
                                    </div>
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <div class="o_priority_star">
                                                <field name="priority" widget="priority" readonly="1"/>
                                            </div>
                                            <div class="oe_kanban_avatar">
                                                <img t-att-src="kanban_image('res.users', 'avatar_128', record.assigned_to.raw_value)" t-att-title="record.assigned_to.value" t-att-alt="record.assigned_to.value" width="24" height="24" class="oe_kanban_avatar"/>
                                            </div>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <div class="badge badge-pill" t-att-class="record.score.value &gt;= 70 ? 'badge-success' : record.score.value &gt;= 50 ? 'badge-warning' : 'badge-secondary'">
                                                Score: <t t-esc="record.score.value"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Lead Search View -->
    <record id="property_lead_view_search" model="ir.ui.view">
        <field name="name">property.lead.search</field>
        <field name="model">property.lead</field>
        <field name="arch" type="xml">
            <search string="Search Leads">
                <field name="lead_name"/>
                <field name="contact_name"/>
                <field name="email"/>
                <field name="phone"/>
                <field name="assigned_to"/>
                <field name="source"/>
                <field name="stage_id"/>
                <separator/>
                <filter string="My Leads" name="my_leads" domain="[('assigned_to', '=', uid)]"/>
                <filter string="Unassigned" name="unassigned" domain="[('assigned_to', '=', False)]"/>
                <filter string="New" name="new" domain="[('state', '=', 'new')]"/>
                <filter string="Qualified" name="qualified" domain="[('state', '=', 'qualified')]"/>
                <filter string="Hot Leads" name="hot" domain="[('priority', '=', '3')]"/>
                <filter string="High Score" name="high_score" domain="[('score', '>=', 70)]"/>
                <separator/>
                <filter string="Today" name="today" domain="[('create_date', '>=', context_today().strftime('%Y-%m-%d'))]"/>
                <filter string="This Week" name="this_week" domain="[('create_date', '>=', (context_today() - datetime.timedelta(days=7)).strftime('%Y-%m-%d'))]"/>
                <filter string="This Month" name="this_month" domain="[('create_date', '>=', context_today().strftime('%Y-%m-01'))]"/>
                <separator/>
                <filter string="Won" name="won" domain="[('state', '=', 'won')]"/>
                <filter string="Lost" name="lost" domain="[('state', '=', 'lost')]"/>
                <group expand="0" string="Group By">
                    <filter string="Assigned To" name="group_assigned_to" domain="[]" context="{'group_by': 'assigned_to'}"/>
                    <filter string="Source" name="group_source" domain="[]" context="{'group_by': 'source'}"/>
                    <filter string="Stage" name="group_stage" domain="[]" context="{'group_by': 'stage_id'}"/>
                    <filter string="State" name="group_state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Budget Range" name="group_budget" domain="[]" context="{'group_by': 'budget_range'}"/>
                    <filter string="Unit Type" name="group_unit_type" domain="[]" context="{'group_by': 'unit_type_preference'}"/>
                    <filter string="Priority" name="group_priority" domain="[]" context="{'group_by': 'priority'}"/>
                    <filter string="Creation Date" name="group_create_date" domain="[]" context="{'group_by': 'create_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Lead Actions -->
    <record id="property_lead_action" model="ir.actions.act_window">
        <field name="name">Property Leads</field>
        <field name="res_model">property.lead</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="property_lead_view_search"/>
        <field name="context">{'search_default_my_leads': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first property lead!
            </p>
            <p>
                Manage prospects and track your sales pipeline effectively.
            </p>
        </field>
    </record>

    <!-- Lead Stage Views -->
    <record id="property_lead_stage_view_form" model="ir.ui.view">
        <field name="name">property.lead.stage.form</field>
        <field name="model">property.lead.stage</field>
        <field name="arch" type="xml">
            <form string="Lead Stage">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="is_default"/>
                        <field name="fold"/>
                        <field name="color" widget="color_picker"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="property_lead_stage_view_tree" model="ir.ui.view">
        <field name="name">property.lead.stage.list</field>
        <field name="model">property.lead.stage</field>
        <field name="arch" type="xml">
            <list string="Lead Stages" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="description"/>
                <field name="is_default"/>
                <field name="fold"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="property_lead_stage_action" model="ir.actions.act_window">
        <field name="name">Lead Stages</field>
        <field name="res_model">property.lead.stage</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
