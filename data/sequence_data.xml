<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Property Sequence -->
        <record id="seq_property" model="ir.sequence">
            <field name="name">Property</field>
            <field name="code">property.property</field>
            <field name="prefix">PROP/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Property Unit Sequence -->
        <record id="seq_property_unit" model="ir.sequence">
            <field name="name">Property Unit</field>
            <field name="code">property.unit</field>
            <field name="prefix">UNIT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Property Contract Sequence -->
        <record id="seq_property_contract" model="ir.sequence">
            <field name="name">Property Contract</field>
            <field name="code">property.contract</field>
            <field name="prefix">CONT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Property Maintenance Sequence -->
        <record id="seq_property_maintenance" model="ir.sequence">
            <field name="name">Property Maintenance</field>
            <field name="code">property.maintenance</field>
            <field name="prefix">MAINT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
